# === instagen — Configurazione Ambiente (Fase 1: Export Assistito) ===
# Copia questo file in `.env` e compila i valori locali.
# NON committare mai `.env` su Git.

# Canale di uscita ("local_assisted" per Fase 1 MVP)
INSTAGEN_OUTPUT_CHANNEL=local_assisted
INSTAGEN_EXPORT_DIR=./output

# Analisi VLM (Cloud Gemini)
VLM_PROVIDER=gemini
VLM_MODEL=gemini-2.5-pro
VLM_API_KEY=your_gemini_api_key_here

# Trascrizione audio locale (faster-whisper)
WHISPER_MODEL=base

# Strategia Hashtag ("Millennium's Bug tail effect")
HASHTAG_MAX_COUNT=5
HASHTAG_SERIES_TAG=#InstagenSeries

# === Fase 2 (Opzionale): Instagram Graph API Ufficiale ===
# IG_AUTH_FLOW=facebook_login
# META_APP_ID=
# META_APP_SECRET=
# IG_USER_ID=
# IG_ACCESS_TOKEN=
